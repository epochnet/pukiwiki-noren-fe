# ---- connection to PukiWiki (required) ----
PUKIWIKI_URL=https://wiki.example.com/
# Docker のネットワーク内の名前などで接続するとき、利用者のブラウザから開ける URL（「元の画面で開く」などのリンク用）
# PUKIWIKI_PUBLIC_URL=https://wiki.example.com/
PUKIWIKI_LABEL=Wiki
# auto | euc-jp | utf-8
PUKIWIKI_ENCODING=auto
# Used automatically for attachment uploads when the wiki limits uploads to admins
# (PLUGIN_ATTACH_UPLOAD_ADMIN_ONLY). Leave empty to ask users for the password.
PUKIWIKI_ADMIN_PASSWORD=
# PUKIWIKI_BASIC_USER=
# PUKIWIKI_BASIC_PASSWORD=
PUKIWIKI_CONCURRENCY=4
PUKIWIKI_TZ_OFFSET=9

# ---- several wikis: use a YAML file instead (see config/wikis.example.yaml) ----
# WIKIS_CONFIG=/config/wikis.yaml

# ---- listening address ----
# Default 127.0.0.1 (this machine only). The Docker image listens on 0.0.0.0 inside
# the container, and compose.yml publishes it on the host's 127.0.0.1 only.
# HOST=127.0.0.1
# PORT=8080

# ---- users: none | header | tailscale ----
# none:      no user names (only for 127.0.0.1 or behind a proxy that authenticates)
# header:    user name from AUTH_HEADER, set by an authenticating reverse proxy
# tailscale: user name from the Tailscale-User-Login header added by `tailscale serve`
AUTH_MODE=none
# AUTH_HEADER=X-Forwarded-User

# ---- AI assistant (optional) ----
# anthropic (Claude API) | openai (OpenAI-compatible Chat Completions: OpenAI, llama.cpp, vLLM, Ollama ...)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# used when AI_PROVIDER=openai. Base URL up to /v1 (…/chat/completions is appended). AGENT_MODEL is required.
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_API_KEY=
# pages the AI must never see (glob, comma separated), e.g. Secret,Secret/*
AGENT_EXCLUDE_PAGES=
# MCP_URL=http://pukiwiki-mcp:8000/mcp

SYNC_INTERVAL=60
FULL_SYNC_HOUR=3
